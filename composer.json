{
    "name": "fakturnaut/sdk",
    "description": "Fakturnaut API client: issue, validate, deliver and check EN 16931 e-invoices (XRechnung, ZUGFeRD, RO e-Factura).",
    "type": "library",
    "license": "MIT",
    "homepage": "https://fakturnaut.com/docs",
    "keywords": ["e-invoice", "xrechnung", "zugferd", "en16931", "peppol", "e-factura"],
    "authors": [{"name": "Fakturnaut", "homepage": "https://fakturnaut.com"}],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.4.5",
        "guzzlehttp/psr7": "^1.9.1 || ^2.4.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {"Fakturnaut\\Sdk\\": "lib/"}
    },
    "autoload-dev": {
        "psr-4": {"Fakturnaut\\Sdk\\Test\\": "test/"}
    }
}
